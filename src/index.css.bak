@tailwind base;
@tailwind components;
@tailwind utilities;

/* --- BuyerBoard helpers (keep) --- */
:root { --primary:#0E57FF; }
.card { @apply bg-white border border-slate-200 rounded-2xl; }
.shadow-soft { box-shadow: 0 8px 28px rgba(2,6,23,0.06); }
.bg-brand-gradient { @apply bg-gradient-to-r from-[#0E57FF] to-[#14C6F1]; }
.btn-primary { @apply inline-flex items-center px-5 py-3 rounded-xl text-white bg-[#0E57FF] hover:bg-[#0d4be0] transition; }
