import React from "react";
const API_BASE = (import.meta.env?.VITE_API_BASE || "https://2v0q4zm2v6.execute-api.us-east-1.amazonaws.com/dev").replace(/\/$/,"");

export default function LeadForm(){
  const [form,setForm] = React.useState({ role:"buyer", name:"", email:"", phone:"", zip:"", notes:"" });
  const [msg,setMsg]   = React.useState("");

  const upd = k => e => setForm(s=>({...s,[k]:e.target.value}));

  async function onSubmit(e){
    e.preventDefault();
    setMsg("Submitting");
    try{
      const res = await fetch(`${API_BASE}/v1/ingest`, {
        method:"POST",
        headers:{ "Content-Type":"application/json" },
        body: JSON.stringify({ source:"landing", ...form })
      });
      const data = await res.json().catch(()=> ({}));
      if(!res.ok) throw new Error(data?.error || "Submit failed");
      setMsg("Thanks! Well be in touch shortly.");
      setForm({ role:"buyer", name:"", email:"", phone:"", zip:"", notes:"" });
    }catch(err){ setMsg(err.message); }
 
