import { useState } from "react";
import { loginAgent } from "../lib/api";

export default function Login() {
  const [email, setEmail] = useState("cclark@prodigyassurance.com");
  const [password, setPassword] = useState("K@t13DyD");
  const [err, setErr] = useState("");

  async function onSubmit(e) {
    e.preventDefault();
    setErr("");
    try {
      await loginAgent(email, password);
      window.location.href = "/dashboard";
    } catch (ex) {
      setErr(ex.message || "Login failed");
    }
  }

  return (
    <div className="min-h-screen flex items-center justify-center px-4">
      <form onSubmit={onSubmit} className="w-full max-w-sm space-y-4 border p-6 rounded-xl shadow">
        <h1 className="text-xl font-semibold">Agent Login</h1>
        <input className="w-full border rounded px-3 py-2" value={email} onChange={e=>setEmail(e.target.value)} placeholder="email" />
        <input className="w-full border rounded px-3 py-2" type="password" value={password} onChange={e=>setPassword(e.target.value)} placeholder="password" />
        {err ? <div className="text-red-600 text-sm">{err}</div> : null}
        <button className="w-full rounded bg-blue-600 text-white py-2">Sign in</button>
      </form>
    </div>
  );
}
