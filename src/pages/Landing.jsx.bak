/* ------- helpers ------- */

function MetricFeature({ metric, caption, title, text }){
  return (
    <div className="card shadow-soft p-6">
      <div className="text-center">
        <div className="text-3xl font-extrabold text-slate-800">{metric}</div>
        <div className="text-sm text-slate-500 mt-1">{caption}</div>
      </div>
      <div className="my-5 h-px bg-gradient-to-r from-transparent via-gray-200 to-transparent"/>
      <div>
        <h3 className="font-semibold text-lg">{title}</h3>
        <p className="text-gray-600 mt-1">{text}</p>
      </div>
    </div>
  );
}

function Testimonial({ quote, name }){
  return (
    <div className="relative">
      <div className="rounded-3xl bg-blue-50/60 border border-blue-100 p-5 pr-24 text-[15px] text-slate-700">
        {quote}
        <div className="mt-3 text-blue-500 text-sm font-medium flex items-center gap-2">
          <span className="opacity-60"></span>{name}
        </div>
      </div>
      <div className="absolute -right-4 -bottom-4 h-16 w-16 rounded-full ring-4 ring-white shadow-md bg-gradient-to-br from-blue-300 to-blue-500" />
    </div>
  );
}

function BigCarousel({ slides }){
  const [i,setI]=React.useState(0);
  const hold=React.useRef(false);
  React.useEffect(()=>{
    const id=setInterval(()=>{ if(!hold.current) setI(v=>(v+1)%slides.length); },4000);
    return ()=>clearInterval(id);
  },[slides.length]);
  const s=slides[i];
  return (
    <div className="relative max-w-4xl mx-auto"
         onMouseEnter={()=>hold.current=true} onMouseLeave={()=>hold.current=false}>
      <div className="card shadow-soft overflow-hidden">
        <div className="h-[420px] bg-gradient-to-br from-gray-50 to-gray-100 flex items=end">
          <div className="w-full p-6">
            <div className="rounded-2xl bg-white/90 border border-gray-200 p-5 h-[300px] overflow-hidden">
              <div className="font-semibold text-gray-900 text-lg line-clamp-1">{s.title}</div>
              <div className="text-gray-600 line-clamp-1">{s.subtitle}</div>
              <div className="mt-4 rounded-xl bg-gray-50 border border-gray-200 h-full" />
            </div>
          </div>
        </div>
        <img src={s.badge} alt="" className="absolute -right-4 -top-4 h-10 w-10 rounded-full ring-4 ring-white shadow-md"
             onError={(e)=>e.currentTarget.style.display='none'}/>
      </div>
      <div className="absolute inset-x-0 -bottom-4 flex items-center justify-center gap-2">
        {slides.map((_,idx)=>(
          <button key={idx} onClick={()=>setI(idx)}
            className={`h-2.5 rounded-full transition-all ${idx===i ? "w-8 bg-blue-600":"w-2.5 bg-gray-300 hover:bg-gray-400"}`} />
        ))}
      </div>
    </div>
  );
}

function SimpleLeadForm(){
  return (
    <form className="grid md:grid-cols-2 gap-4 text-sm">
      <input className="border border-gray-300 rounded-lg px-3 py-2" placeholder="Full name" />
      <input className="border border-gray-300 rounded-lg px-3 py-2" placeholder="Email" />
      <input className="border border-gray-300 rounded-lg px-3 py-2" placeholder="Phone" />
      <input className="border border-gray-300 rounded-lg px-3 py-2" placeholder="ZIP" />
      <input className="border border-gray-300 rounded-lg px-3 py-2" placeholder="Max price $" />
      <input className="border border-gray-300 rounded-lg px-3 py-2" placeholder="Beds" />
      <textarea className="md:col-span-2 border border-gray-300 rounded-lg px-3 py-2" rows="4" placeholder="Neighborhoods, timing, pre-approval, must-haves..."></textarea>
      <div className="md:col-span-2">
        <button type="button" className="px-4 py-2 rounded-xl bg-blue-600 text-white">Submit</button>
      </div>
    </form>
  );
}

