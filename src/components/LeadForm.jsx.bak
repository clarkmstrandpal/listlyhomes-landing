import React from "react";
const API_BASE = (import.meta.env?.VITE_API_BASE || "https://2v0q4zm2v6.execute-api.us-east-1.amazonaws.com/dev").replace(/\/$/,"");

export default function LeadForm(){
  const [form,setForm] = React.useState({ role:"buyer", name:"", email:"", phone:"", zip:"", notes:"" });
  const [msg,setMsg]   = React.useState("");

  const upd = k => e => setForm(s=>({...s,[k]:e.target.value}));

  async function onSubmit(e){
    e.preventDefault();
    setMsg("Submitting");
    try{
      const res = await fetch(`${API_BASE}/v1/ingest`, {
        method:"POST",
        headers:{ "Content-Type":"application/json" },
        body: JSON.stringify({ source:"landing", ...form })
      });
      const data = await res.json().catch(()=> ({}));
      if(!res.ok) throw new Error(data?.error || "Submit failed");
      setMsg("Thanks! Well be in touch shortly.");
      setForm({ role:"buyer", name:"", email:"", phone:"", zip:"", notes:"" });
    }catch(err){ setMsg(err.message || "Error"); }
  }

  return (
    <form id="buyers" onSubmit={onSubmit} className="card" style={{padding:16}}>
      <div className="grid grid-2">
        <select className="input" value={form.role} onChange={upd("role")}>
          <option value="buyer">Buyer</option>
          <option value="seller">Seller</option>
          <option value="renter">Renter</option>
          <option value="landlord">Landlord</option>
          <option value="other">Other</option>
        </select>
        <input className="input" placeholder="Full name" value={form.name} onChange={upd("name")} />
        <input className="input" placeholder="Email" value={form.email} onChange={upd("email")} />
        <input className="input" placeholder="Phone" value={form.phone} onChange={upd("phone")} />
        <input className="input" placeholder="ZIP" value={form.zip} onChange={upd("zip")} />
        <textarea className="input" rows={4} placeholder="Neighborhoods, timing, pre-approval, must-haves" value={form.notes} onChange={upd("notes")} />
      </div>
      <div style={{marginTop:10,display:"flex",alignItems:"center",gap:10}}>
        <button className="btn btn-primary" type="submit">Submit</button>
        <span className="small">{msg}</span>
      </div>
    </form>
  );
}
